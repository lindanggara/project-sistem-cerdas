# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Jupyter
.ipynb_checkpoints/
notebooks/*_output.ipynb

# Local datasets (keep directory structure with .gitkeep)
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Trained artifacts and large files
models/*
!models/README.md
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx
*.parquet
*.feather
*.zip

# Reports generated locally
reports/figures/*
reports/results/*
!reports/figures/.gitkeep
!reports/results/.gitkeep
!reports/results/eksperimen.md
!reports/figures/*.png

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log